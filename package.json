{
  "name": "coder",
  "version": "0.1.0",
  "private": true,
  "description": "Coder - desktop agentic development tool",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "electron": "electron .",
    "package": "bash scripts/package-app.sh",
    "acceptance": "electron scripts/acceptance.js",
    "test:renderer": "CODER_GROK_MCP_DISABLE=1 node --import=./test/support/render.mjs --experimental-strip-types --test --test-timeout=20000 test/*.test.ts test/*.test.tsx",
    "test:electron": "node --test electron/test/*.test.js",
    "test:memory": "cd memory-server && node --test test/*.test.js"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "electron": "^35.2.0",
    "jsdom": "^30.0.1",
    "typescript": "^5.8.3",
    "vite": "^6.3.3"
  },
  "allowScripts": {
    "electron@35.7.5": true,
    "esbuild@0.25.12": true
  }
}
